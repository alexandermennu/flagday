APP_NAME="Starz University Class of 2026"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local dev defaults to the "log" driver (mail is written to storage/logs/laravel.log
# instead of actually sent). In production, set MAIL_MAILER=resend and RESEND_API_KEY
# below — MAIL_FROM_ADDRESS must be on a domain verified in your Resend account.
# RSVP emails always display "Starz University" as the sender name (GRAD_INSTITUTION),
# and set no Reply-To, so replies go to MAIL_FROM_ADDRESS.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="Starz University"

RESEND_API_KEY=

# --- Starz University Class of 2026 graduation site ---
# Leave any detail empty to show "To be announced" on the site. Dates are YYYY-MM-DD,
# times are 24h HH:MM. Program PDFs take a URL or a path under /public.
GRAD_INSTITUTION="Starz University"
GRAD_CLASS_YEAR=2026
GRAD_CONTACT_EMAIL=
GRAD_CONTACT_PHONE=

# Honors Ball — the RSVP event (also used by tickets, emails, and the calendar file)
EVENT_NAME="Starz University Honors Ball 2026"
EVENT_DATE=
EVENT_START_TIME=
EVENT_END_TIME=
EVENT_TIMEZONE=Africa/Monrovia
EVENT_VENUE=
EVENT_VENUE_ADDRESS=
EVENT_DRESS_CODE=
HONORS_BALL_PROGRAM_PDF=
# RSVP access code gate — off for now.
EVENT_RSVP_PASSCODE_REQUIRED=false
EVENT_RSVP_PASSCODE=

BACCALAUREATE_DATE=
BACCALAUREATE_TIME=
BACCALAUREATE_VENUE=
BACCALAUREATE_VENUE_ADDRESS=
BACCALAUREATE_DRESS_CODE=
BACCALAUREATE_PROGRAM_PDF=

CONVOCATION_DATE=
CONVOCATION_TIME=
CONVOCATION_VENUE=
CONVOCATION_VENUE_ADDRESS=
CONVOCATION_DRESS_CODE=
CONVOCATION_PROGRAM_PDF=

# Largest Convocation program PDF the admin may upload, in KB (PHP's upload limits must allow it).
PROGRAM_PDF_MAX_KB=20480

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
