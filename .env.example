APP_NAME="National Flag Day RSVP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local dev defaults to the "log" driver (mail is written to storage/logs/laravel.log
# instead of actually sent). In production, set MAIL_MAILER=resend and RESEND_API_KEY
# below — MAIL_FROM_ADDRESS must be on a domain verified in your Resend account.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

RESEND_API_KEY=

EVENT_NAME="National Flag Day"
EVENT_DATE=2026-08-24
EVENT_START_TIME=09:00
EVENT_END_TIME=12:00
EVENT_TIMEZONE=Africa/Monrovia
EVENT_VENUE="Centennial Pavilion"
EVENT_VENUE_ADDRESS="Monrovia, Liberia"
EVENT_DRESS_CODE="National / Formal Attire"
EVENT_THEME="From Heritage to Hope: The Flag That Unites Us."
EVENT_CONTACT_PHONE="+231 777 659 166"
EVENT_CONTACT_PHONE_SECONDARY="+231 886 659 166"
EVENT_CONTACT_WHATSAPP="+231 886 659 166"
EVENT_CONTACT_EMAIL="events@moe.gov.lr"
EVENT_CONTACT_WEBSITE="www.moe.gov.lr"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
